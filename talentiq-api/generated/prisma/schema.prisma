// talentiq-api/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── User ──────────────────────────────────────────────────────────────────────
model User {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  password         String
  isVerified       Boolean   @default(false)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relasi ke profil
  profile Profile?
}

// ── Profile ───────────────────────────────────────────────────────────────────
model Profile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetRole      String? // Posisi yang diincar
  experienceLevel String? // Fresh Graduate / Junior / Mid / Senior
  skills          String[] // Array skill yang dimiliki
  avatarUrl       String? // URL foto profil

  // Stats kursus
  activeCourses    Int @default(0)
  completedCourses Int @default(0)
  totalHours       Int @default(0)
  streakDays       Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
